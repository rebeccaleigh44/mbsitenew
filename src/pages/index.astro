---
// Home (mb-alt, 2026-10-28): the Figma "Mediabarn alt" hero with a live silk background, then a
// lighter, centered, image-led layout. The loop home lives on in mb2.0.
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroAlt from '@/components/site/HeroAlt.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import Note from '@/components/site/Note.astro';
import Cta from '@/components/site/Cta.astro';
import { pillars, products } from '@/data/site';
import { photos } from '@/data/images';
import { Image } from 'astro:assets';
import chirpDashboard from '@/assets/products/chirp-dashboard.png';
import edjitDashboard from '@/assets/products/edjit-dashboard.png';
import timeWeek from '@/assets/products/time-week.png';
import cxCover from '@/assets/products/cxalign-report-cover.jpg';
import cxSummary from '@/assets/products/cxalign-report-summary.jpg';
import cxAudit from '@/assets/products/cxalign-report-audit.jpg';

const sectors = [
	{ t: 'Federal', h: '/federal/', d: 'Forms, portals, and services that citizens and taxpayers can actually finish, with Section 508 compliance built in.', tint: 'rgba(30,65,170,.38)', mood: 'dusk' as const, photo: photos.capitolSunset },
	{ t: 'Healthcare', h: '/healthcare/', d: 'Patient, practitioner, and payer journeys mapped, measured, and improved, one initiative at a time.', tint: 'rgba(129,117,112,.38)', mood: 'clay' as const, photo: photos.careConversation },
];
// one photo per pillar, from the supplied photography
// products bento: grid order is Chirp (lead), Time, Edjit, CXAlign; CXAlign shows three of its report pages fanned out
const bySlug = Object.fromEntries(products.map((p) => [p.slug, p]));
const bento = [
	{ slug: 'chirp', p: bySlug.chirp, shot: chirpDashboard, sizes: '(min-width: 1021px) 520px, 100vw' },
	{ slug: 'time', p: bySlug.time, shot: timeWeek, sizes: '(min-width: 1021px) 300px, 100vw' },
	{ slug: 'edjit', p: bySlug.edjit, shot: edjitDashboard, sizes: '(min-width: 1021px) 460px, 100vw' },
	{ slug: 'cx-align', p: bySlug['cx-align'], pages: [cxAudit, cxSummary, cxCover] },
];
const pillarPhotos = [photos.researchInterview, photos.designWorkshop, photos.phoneAtWindow];

---

<BaseLayout title="Creating experiences the human-centered way" nav="hero" description="Mediabarn uses Human-Centered Design to deliver the best digital experiences for customers, citizens, patients, and employees.">
	<HeroAlt />

	{/* ---------- Three ways in ---------- */}
	<section class="alt-sec bg-[var(--paper-light)]" aria-labelledby="ways-h">
		<div class="wrap">
			<h2 id="ways-h" data-reveal class="mx-auto max-w-[22ch] text-center">Research, design, and product. Start with one, or bring us in for all <span class="em">three</span>.</h2>
			<ol role="list" data-stagger class="mt-16 grid gap-6 desk:grid-cols-3">
				{pillars.map((p, i) => (
					<li style={`--i:${i}`}>
						<a href={p.href} class="pillar-card group flex h-full flex-col border border-[var(--line)] bg-[var(--paper)] transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-[var(--red)]">
							<div data-unveil class="pillar-img"><Placeholder label={`${p.name}: photography`} ratio="4/3" src={pillarPhotos[i]} /></div>
							<div class="flex grow flex-col justify-center gap-3 p-7">
								<h3 class="font-serif !text-[34px] leading-none">{p.name}</h3>
								<p class="body grow">{p.oneLiner}</p>
								<span class="link self-start">Explore {p.name.toLowerCase()} <span class="arrow" aria-hidden="true">→</span></span>
							</div>
						</a>
					</li>
				))}
			</ol>
		</div>
	</section>

	{/* ---------- Where we work: photo cards in the hero strip's style ---------- */}
	<section class="alt-sec" aria-labelledby="where-h">
		<div class="wrap">
			<div data-stagger class="mb-14 grid gap-6 desk:grid-cols-[1fr_1fr] desk:items-end">
				<h2 id="where-h" class="max-w-[14ch]">Where UX can be challenging…</h2>
				<p class="lede max-w-[46ch] desk:justify-self-end" style="--i:1">Most of our work is in government services and healthcare, where getting the experience wrong costs people time, money, and care.</p>
			</div>
			<div data-stagger class="grid gap-6 tab:grid-cols-2">
				{sectors.map((s, i) => (
					<a href={s.h} class="group relative block overflow-hidden" style={`--i:${i}`}>
						<Placeholder label={`${s.t}: photography`} ratio="5/4" src={s.photo} class="parallax transition-transform duration-700 group-hover:scale-[1.03]" />
						<div class="absolute inset-0" style={`background:${s.tint}`}></div>
						<div class="absolute inset-x-0 bottom-0 grid gap-3 p-8 text-[var(--paper-light)]">
							<h3 class="font-serif !text-[clamp(40px,4.4vw,60px)] leading-none !text-[var(--paper-light)]">{s.t} <svg class="arrow chev" viewBox="0 0 12 20" aria-hidden="true"><path d="M2 2l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></h3>
							<p class="max-w-[40ch] text-[16px] leading-[1.6] text-[color-mix(in_srgb,var(--paper-light)_88%,transparent)]">{s.d}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	{/* ---------- Products: a bento. Chirp leads on a dark tile; Time, Edjit, and CXAlign support it.
	    Each tile shows the product's real screens rising out of the bottom edge. ---------- */}
	<section class="alt-sec bg-[#E2D5C6]" aria-labelledby="prod-h">
		<div class="wrap">
			<div data-stagger class="mb-14 grid gap-6 desk:grid-cols-2 desk:items-end">
				<h2 id="prod-h" class="max-w-[14ch]">Software that came out of the <span class="em">work</span>.</h2>
				<p class="lede max-w-[46ch] !text-[#483933] desk:justify-self-end" style="--i:1">We kept seeing the same problems across clients, so we built tools for them.</p>
			</div>
			<ul role="list" data-stagger class="bento">
				{bento.map((b, i) => (
					<li class={`bx-${b.slug}`} style={`--i:${i}`}>
						<a href={b.p.href} class="bx group">
							<div class="bx-text">
								<span class="eyebrow">For {b.p.for.toLowerCase()}</span>
								<span class="bx-name">{b.p.name}</span>
								<span class="body">{b.p.summary}</span>
								<span class="link self-start text-[15px]">Explore {b.p.name} <span class="arrow" aria-hidden="true">→</span></span>
							</div>
							{b.pages
								? <div class="bx-pages" aria-hidden="true">{b.pages.map((pg) => <Image src={pg} alt="" widths={[300, 600]} sizes="240px" class="bx-page" />)}</div>
								: <div class="bx-shot" aria-hidden="true"><span class="bx-bar"><i></i><i></i><i></i></span><Image src={b.shot} alt="" widths={[600, 900, 1200]} sizes={b.sizes} /></div>}
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	{/* ---------- Track record ---------- */}
	<section class="alt-sec bg-[var(--paper-light)]" aria-labelledby="track-h">
		<div class="wrap">
			<h2 id="track-h" class="sr-only">Track record</h2>
			<figure data-reveal class="mx-auto max-w-[900px] text-center">
				<blockquote class="font-serif text-[clamp(26px,3vw,40px)] leading-[1.22]">“I can honestly say you all have been the 100% best of all the markets in this study. Absolutely no issues, so professional, great respondents, cool facility, & fun to work with on top of all that.”</blockquote>
				<figcaption class="eyebrow mt-8">Lead Researcher, national research study</figcaption>
			</figure>
		</div>
	</section>

	<div data-reveal><Cta /></div>
</BaseLayout>

<style>
	/* pillar cards on tablets and large phones (621–1020px): photo beside the text instead of a full-width
	   4:3 photo above it, so each card is about a third as tall */
	@media (621px <= width < 1021px) {
		.pillar-card { flex-direction: row; }
		.pillar-img { flex: 0 0 38%; }
		.pillar-img :global(.ph) { aspect-ratio: auto !important; height: 100%; min-height: 200px; }
		.pillar-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
	}
	.alt-sec { padding-block: clamp(72px, 9vw, 140px); color: #483933; }
	.alt-sec h2 { color: #483933; }
	/* products bento */
	.bento { display: grid; gap: 20px; }
	.bento > li { display: flex; }
	.bx { position: relative; display: flex; flex-direction: column; gap: 32px; width: 100%; overflow: hidden; padding: 32px 32px 0; background: var(--paper-light); transition: transform .35s var(--ease); }
	.bx:hover { transform: translateY(-4px); }
	.bx-text { display: flex; flex-direction: column; gap: 12px; max-width: 46ch; }
	.bx-name { font-family: var(--font-serif); font-size: clamp(32px, 3vw, 44px); line-height: 1; color: #483933; }
	.bx-shot { margin-top: auto; overflow: hidden; border-radius: 6px 6px 0 0; background: #fff; box-shadow: 0 -1px 0 rgba(30,18,14,.06), 0 18px 40px -16px rgba(30,18,14,.4); transition: translate .5s var(--ease); }
	.bx:hover .bx-shot { translate: 0 -6px; }
	.bx-bar { display: flex; gap: 5px; padding: 8px 10px; background: #F3EEE6; border-bottom: 1px solid rgba(30,18,14,.08); }
	.bx-bar i { width: 7px; height: 7px; border-radius: 50%; background: rgba(30,18,14,.18); }
	.bx-shot :global(img) { display: block; width: 100%; height: auto; }
	/* Chirp: the lead tile, dark */
	.bx-chirp .bx { background: var(--cocoa); }
	.bx-chirp .bx-name, .bx-chirp .eyebrow, .bx-chirp .link { color: var(--paper-light); }
	.bx-chirp .body { color: var(--sand); }
	/* CXAlign: three report pages fanned out, rising from the bottom edge */
	.bx-pages { position: relative; margin-top: auto; aspect-ratio: 1.72; } /* sized from its width, so the pages always sit just under the text */
	.bx-page { position: absolute; bottom: -16%; width: clamp(130px, 52%, 270px); height: auto; box-shadow: 0 18px 36px -14px rgba(30,18,14,.45); transition: rotate .5s var(--ease), translate .5s var(--ease); }
	.bx-page:nth-child(1) { left: 2%; rotate: -7deg; }
	.bx-page:nth-child(2) { left: 22%; rotate: 3deg; }
	.bx-page:nth-child(3) { left: 44%; rotate: -1deg; bottom: -24%; }
	.bx:hover .bx-page:nth-child(1) { rotate: -10deg; translate: -10px -6px; }
	.bx:hover .bx-page:nth-child(2) { rotate: 5deg; translate: 0 -10px; }
	.bx:hover .bx-page:nth-child(3) { translate: 10px -8px; }
	@media (min-width: 761px) {
		.bento { grid-template-columns: repeat(2, 1fr); }
		.bx-chirp, .bx-cx-align { grid-column: 1 / -1; }
		.bx-cx-align .bx-pages { aspect-ratio: 3; }
		.bx-cx-align .bx-page { width: 30%; }
		.bx-cx-align .bx-page:nth-child(1) { left: 22%; } .bx-cx-align .bx-page:nth-child(2) { left: 38%; } .bx-cx-align .bx-page:nth-child(3) { left: 54%; }
	}
	@media (min-width: 1021px) {
		.bento { grid-template-columns: repeat(6, 1fr); grid-template-areas: "chirp chirp chirp chirp time time" "edjit edjit edjit cx cx cx"; }
		.bx-cx-align .bx-pages { aspect-ratio: 1.96; }
		.bx-cx-align .bx-page { width: clamp(130px, 46%, 270px); }
		.bx-cx-align .bx-page:nth-child(1) { left: 12%; } .bx-cx-align .bx-page:nth-child(2) { left: 30%; } .bx-cx-align .bx-page:nth-child(3) { left: 48%; }
		.bx-chirp { grid-area: chirp; } .bx-time { grid-area: time; } .bx-edjit { grid-area: edjit; } .bx-cx-align { grid-area: cx; }
		.bx-chirp .bx { flex-direction: row; align-items: flex-end; padding-right: 0; }
		.bx-chirp .bx-text { flex: 0 0 38%; align-self: center; padding-bottom: 32px; }
		.bx-chirp .bx-shot { flex: 1; margin-top: 40px; }
		.bx-edjit .bx-shot { margin-left: 18%; margin-right: -32px; border-top-right-radius: 0; }
	}

	/* minimal chevron after the sector titles: a thin stroke at about a third of the cap height */
	.chev { width: .22em; height: .36em; margin-left: .18em; vertical-align: .1em; }
</style>
